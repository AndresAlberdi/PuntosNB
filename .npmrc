# No se ejecutan los scripts de instalación de las dependencias: un paquete
# comprometido no debe poder correr código solo por instalarse.
ignore-scripts=true
# El lockfile manda: si no coincide con package.json, la instalación falla
# en lugar de resolver versiones nuevas por su cuenta.
frozen-lockfile=true
auto-install-peers=true

# Cuarentena de siete días antes de aceptar una versión recién publicada, la misma que
# declara pnpm-workspace.yaml. Hay que escribirla dos veces porque cada gestor la lee con
# otro nombre y en otra unidad:
#   - pnpm:  `minimum-release-age`, en MINUTOS (10080 = 7 días).
#   - npm:   `min-release-age`, en DÍAS (disponible desde npm 11.10).
# Antes solo figuraba la forma de pnpm, y npm la ignoraba en silencio —de ahí el aviso
# «Unknown project config» en cada comando— aunque el comentario afirmaba que valía para
# cualquier gestor. npm sí se usa: genera y consume `functions/package-lock.json`, que es
# lo que Firebase instala en la nube.
minimum-release-age=10080
min-release-age=7
