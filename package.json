{
  "name": "puntosnb-app",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:prod",
    "build:prod": "tsc -b && vite build --mode production",
    "build:staging": "tsc -b && vite build --mode staging",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:all": "pnpm test && pnpm test:rules:local && pnpm test:functions:local",
    "test:functions": "vitest run --config functions/vitest.config.ts",
    "typecheck": "tsc -b",
    "test:rules:local": "firebase emulators:exec --only firestore --project demo-hipatia-reglas \"pnpm test:rules\"",
    "test:functions:local": "pnpm --dir functions build && firebase emulators:exec --only functions,firestore,auth --project demo-hipatia-funciones \"pnpm test:functions\""
  },
  "dependencies": {
    "@yudiel/react-qr-scanner": "^2.6.0",
    "date-fns": "^4.4.0",
    "firebase": "^12.14.0",
    "lucide-react": "^1.46.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^14.4.0",
    "firebase-tools": "15.27.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "protobufjs": "^7.6.5",
    "brace-expansion": "^5.0.7"
  },
  "packageManager": "pnpm@11.25.0"
}
