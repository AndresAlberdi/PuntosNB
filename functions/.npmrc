# `functions/` lo instala npm con `npm ci --prefix functions`, y npm lee el `.npmrc` del
# directorio que indica `--prefix`, no el de la raiz. Es decir: las decisiones de cadena de
# suministro del `.npmrc` de la raiz NO se heredan aqui. Medido con npm 12.0.2 y
# `--userconfig /dev/null`, que simula un runner de CI sin `~/.npmrc`:
#
#   npm config get ignore-scripts                     -> true    (raiz)
#   npm config get ignore-scripts  --prefix functions -> false   <- sin este archivo
#   npm config get min-release-age --prefix functions -> null    <- sin este archivo
#
# Hasta ahora, cada despliegue —a pruebas Y A PRODUCCION— instalaba las dependencias del
# backend ejecutando sus scripts de instalacion, que es justo el vector que la raiz cierra a
# proposito. Este archivo lo cierra tambien aqui.

# Ningun paquete ejecuta codigo solo por instalarse.
ignore-scripts=true

# Cuarentena de siete dias antes de aceptar una version recien publicada, la misma que declara
# `minimumReleaseAge: 10080` (minutos) para pnpm. npm la llama distinto y la cuenta en DIAS.
# Afecta a `npm install`, que resuelve; no a `npm ci`, que solo lee el lockfile. El control de
# las actualizaciones automaticas es el `cooldown: 7` de .github/dependabot.yml.
min-release-age=7
