{
  "name": "hipatia-functions",
  "version": "1.0.0",
  "description": "Backend de confianza de Hipatia Puntos: toda la lógica que el cliente no puede ejecutar.",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth"
  },
  "dependencies": {
    "firebase-admin": "14.4.0",
    "firebase-functions": "7.3.2",
    "zod": "4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "eslint": "^10.3.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.1.8"
  }
}
