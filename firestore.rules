rules_version = '2';

// Reglas de Firestore — Hipatia Puntos
//
// Fase 2 del plan de hardening (docs/security/HARDENING_PLAN.md).
//
// Tres cambios de fondo respecto de la Fase 0:
//   1. El rol y el comercio se leen del token firmado (`request.auth.token`), no de un documento
//      que el propio usuario podría editar. Además desaparecen los `get()` por evaluación, que se
//      facturaban como lecturas.
//   2. El libro mayor —transacciones, saldos, sesiones, canjes, cobros y campañas— ya no se
//      escribe desde el cliente: lo escribe el backend con el Admin SDK, que no pasa por aquí.
//   3. Lo que el cliente sí puede escribir está acotado a una lista blanca de campos.
//
// El comodín final deniega todo lo que no esté declarado arriba.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Identidad, tomada del token -----------------------------------------

    function autenticado() {
      return request.auth != null;
    }

    function rol() {
      return request.auth.token.rol;
    }

    function esRol(r) {
      return autenticado() && rol() == r;
    }

    function miComercio() {
      return request.auth.token.comercioId;
    }

    function esDeMiComercio(comercioId) {
      return autenticado() && miComercio() == comercioId;
    }

    function esSuperAdmin() { return esRol('superadmin'); }
    function esContador() { return esRol('contador'); }
    function esAdminComercio() { return esRol('admin_comercio'); }
    function esVendedor() { return esRol('vendedor'); }
    function esCliente() { return esRol('cliente'); }
    function esInfluencer() { return esRol('influencer'); }

    /** Personal del comercio: quien atiende la caja y quien lo administra. */
    function esPersonalDe(comercioId) {
      return (esVendedor() || esAdminComercio()) && esDeMiComercio(comercioId);
    }

    /** La escritura solo toca los campos indicados. */
    function cambiaSolo(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    function creaSolo(campos) {
      return request.resource.data.keys().hasOnly(campos);
    }

    // --- users ----------------------------------------------------------------
    // El perfil propio se edita con lista blanca. El rol, el comercio y el estado los fija el
    // servidor. Los datos de los influencers ya no se leen de aquí, sino de su perfil público.

    match /users/{userId} {
      allow read: if autenticado() && (
        request.auth.uid == userId ||
        esSuperAdmin() ||
        (esAdminComercio() && resource.data.comercioId == miComercio())
      );

      // Alta propia al registrarse: siempre cliente, sin comercio y sin PIN.
      allow create: if autenticado() && request.auth.uid == userId
        && request.resource.data.rol == 'cliente'
        && !('comercioId' in request.resource.data)
        && !('pin' in request.resource.data)
        && creaSolo([
          'uid', 'email', 'nombre', 'rol', 'telefono', 'paletteId', 'avatarUrl',
          'termsAccepted', 'termsAcceptedAt', 'createdAt'
        ]);

      allow update: if autenticado() && request.auth.uid == userId
        && cambiaSolo(['nombre', 'telefono', 'paletteId', 'avatarUrl', 'termsAccepted', 'termsAcceptedAt']);

      // El superadministrador da de alta cuentas administrativas desde su panel.
      allow create, update, delete: if esSuperAdmin();
    }

    // --- comercios: perfil público -------------------------------------------
    // Nombre, catálogo, identidad visual y dos señales derivadas que calcula el servidor
    // (`operativoHasta`, `puedeCanjearPremios`). Ningún dato fiscal ni económico vive aquí.

    match /comercios/{comercioId} {
      allow read: if autenticado();

      // El comercio administra su catálogo y su identidad visual, nada más. El logotipo llega
      // reducido desde el navegador; el límite evita que alguien guarde la imagen original y la
      // haga viajar en cada lectura del comercio.
      allow update: if esAdminComercio() && esDeMiComercio(comercioId)
        && cambiaSolo(['reglas', 'premios', 'productos', 'logoUrl', 'paletteId'])
        && (!('logoUrl' in request.resource.data) || request.resource.data.logoUrl.size() < 40000);

      // El alta, la baja y todo lo demás pasan por el backend.
      allow create, delete: if false;
    }

    // --- comercios_privado: datos fiscales y económicos -----------------------
    // NIT, razón social, plan, mensualidad, costos, saldo prepagado y meses pagados.
    // Solo lo lee quien lo necesita; no lo escribe nadie desde el cliente (H-07, H-16).

    match /comercios_privado/{comercioId} {
      allow read: if esSuperAdmin() || esContador() || (esAdminComercio() && esDeMiComercio(comercioId));
      allow write: if false;
    }

    // --- influencers_publico ---------------------------------------------------
    // Perfil mínimo del influencer para que un comercio pueda invitarlo: nombre, prefijo,
    // descripción y redes. Su teléfono y su correo se quedan en `users`.

    match /influencers_publico/{influencerId} {
      allow read: if autenticado();
      allow write: if false;
    }

    // --- Libro mayor: solo lectura, y solo de lo propio -----------------------

    match /transacciones/{txId} {
      allow read: if autenticado() && (
        esSuperAdmin() ||
        resource.data.clienteId == request.auth.uid ||
        resource.data.influencerId == request.auth.uid ||
        esPersonalDe(resource.data.comercioId)
      );
      allow write: if false;
    }

    match /puntos_saldos/{saldoId} {
      allow read: if autenticado() && (
        esSuperAdmin() ||
        resource.data.clienteId == request.auth.uid ||
        esPersonalDe(resource.data.comercioId)
      );
      allow write: if false;
    }

    match /sesiones_qr/{sesionId} {
      // Quien la creó sigue su estado; el personal del comercio la ve para cobrarla.
      allow read: if autenticado() && (
        esSuperAdmin() ||
        resource.data.creadorId == request.auth.uid ||
        esPersonalDe(resource.data.comercioId)
      );
      allow write: if false;
    }

    match /cobros_prepago/{cobroId} {
      allow read: if autenticado() && (
        esSuperAdmin() ||
        esContador() ||
        (esAdminComercio() && esDeMiComercio(resource.data.comercioId))
      );
      allow write: if false;
    }

    // --- Campañas de influencer y códigos -------------------------------------

    match /asignaciones_influencer/{asignacionId} {
      allow read: if autenticado() && (
        esSuperAdmin() ||
        (esAdminComercio() && esDeMiComercio(resource.data.comercioId)) ||
        (esInfluencer() && resource.data.influencerId == request.auth.uid)
      );
      allow write: if false;
    }

    match /codigos_influencer/{codigoId} {
      allow read: if autenticado() && (
        esSuperAdmin() ||
        (esInfluencer() && resource.data.influencerId == request.auth.uid) ||
        (esAdminComercio() && esDeMiComercio(resource.data.comercioId))
      );
      allow write: if false;
    }

    match /codigos_comercio/{codigoId} {
      allow read: if autenticado() && (
        esSuperAdmin() ||
        esPersonalDe(resource.data.comercioId)
      );
      allow write: if false;
    }

    match /canjes_codigo/{canjeId} {
      allow read: if autenticado() && (
        esSuperAdmin() ||
        resource.data.clienteId == request.auth.uid ||
        esPersonalDe(resource.data.comercioId)
      );
      allow write: if false;
    }

    // --- Colecciones exclusivas del servidor ----------------------------------
    // Secretos de vendedor, auditoría, control de intentos e idempotencia. No se leen ni se
    // escriben desde el cliente, ni siquiera con sesión de superadministrador.

    match /vendedores_secretos/{uid} { allow read, write: if false; }
    match /auditoria/{asientoId} { allow read, write: if false; }
    match /intentos_login_ip/{id} { allow read, write: if false; }
    match /operaciones_idempotentes/{id} { allow read, write: if false; }

    // --- Denegación por defecto ------------------------------------------------
    // Cualquier colección que no esté declarada arriba queda cerrada, incluidas las que se
    // agreguen en el futuro: se abren explícitamente o no se abren.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
