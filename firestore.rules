rules_version = '2';

// Reglas de Firestore — Hipatia Puntos
//
// Fase 0 del plan de hardening (docs/security/HARDENING_PLAN.md): parche de contención.
// Cierra las puertas de compromiso total (H-01 autoescalada de rol, H-02 toma de cuenta por
// coincidencia de correo, H-03 autoaprovisionamiento por dominio, H-07 campos de facturación)
// sin alterar todavía los flujos de puntos, que se mueven al servidor en las fases 1 y 2.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Utilidades -----------------------------------------------------------

    function isAuth() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function existeMiUsuario() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function tieneRol(rol) {
      return isAuth() && existeMiUsuario() && getUserData().rol == rol;
    }

    function isSuperAdmin() { return tieneRol('superadmin'); }
    function isAdminComercio() { return tieneRol('admin_comercio'); }
    function isVendedor() { return tieneRol('vendedor'); }
    function isCliente() { return tieneRol('cliente'); }
    function isInfluencer() { return tieneRol('influencer'); }
    function isContador() { return tieneRol('contador'); }

    function miComercio() {
      return getUserData().comercioId;
    }

    // Campos que la escritura modifica respecto del documento actual.
    function cambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // Campos presentes en un documento que se está creando.
    function creaSolo(campos) {
      return request.resource.data.keys().hasOnly(campos);
    }

    // --- users ----------------------------------------------------------------
    // El rol, el comercio y el estado son del sistema: el usuario nunca los escribe.
    // Se elimina la cláusula de coincidencia por correo (H-02) y el autoaprovisionamiento
    // deja de ser posible porque un cliente solo puede crearse a sí mismo con rol 'cliente' (H-01, H-03).

    match /users/{userId} {
      allow read: if isAuth() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        isContador() ||
        resource.data.rol == 'influencer' ||
        (isAdminComercio() && resource.data.comercioId == miComercio())
      );

      // Alta propia al registrarse: siempre como cliente y sin comercio asignado.
      allow create: if isAuth() && request.auth.uid == userId
        && request.resource.data.rol == 'cliente'
        && !('comercioId' in request.resource.data)
        && !('pin' in request.resource.data)
        && creaSolo([
          'uid', 'email', 'nombre', 'rol', 'telefono', 'paletteId', 'avatarUrl',
          'termsAccepted', 'termsAcceptedAt', 'createdAt'
        ]);

      // Alta y baja administrativas.
      allow create, delete: if isSuperAdmin();
      allow create: if isAdminComercio()
        && request.resource.data.rol == 'vendedor'
        && request.resource.data.comercioId == miComercio();

      // Edición del propio perfil: solo datos personales.
      allow update: if isAuth() && request.auth.uid == userId
        && cambia(['nombre', 'telefono', 'paletteId', 'avatarUrl', 'termsAccepted', 'termsAcceptedAt']);

      // El superadministrador edita cualquier usuario.
      allow update: if isSuperAdmin();

      // El administrador de comercio solo toca a los vendedores de su propio comercio,
      // y nunca su rol ni el comercio al que pertenecen.
      allow update: if isAdminComercio()
        && resource.data.comercioId == miComercio()
        && resource.data.rol == 'vendedor'
        && cambia(['nombre', 'telefono', 'estado', 'pin']);
    }

    // --- comercios ------------------------------------------------------------
    // Los campos de facturación (saldoPremiosBs, plan, modalidadPago, mesesPagados,
    // estado, costos) quedan fuera del alcance del comercio (H-07).

    match /comercios/{comercioId} {
      allow read: if isAuth();

      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin();

      // El comercio administra su catálogo y su identidad visual.
      allow update: if isAdminComercio() && miComercio() == comercioId
        && cambia(['reglas', 'premios', 'productos', 'logoUrl', 'paletteId']);

      // El contador solo acredita cobros.
      allow update: if isContador()
        && cambia(['saldoPremiosBs', 'mesesPagados', 'modalidadPago']);
    }

    // --- cobros_prepago -------------------------------------------------------

    match /cobros_prepago/{cobroId} {
      allow read: if isAuth() && (
        isSuperAdmin() ||
        isContador() ||
        (isAdminComercio() && miComercio() == resource.data.comercioId)
      );
      allow create: if isAuth() && (isSuperAdmin() || isContador());
      allow update: if isAuth() && (isSuperAdmin() || (isContador() && resource.data.contadorId == request.auth.uid));
      allow delete: if isAuth() && (isSuperAdmin() || (isContador() && resource.data.contadorId == request.auth.uid));
    }

    // --- Libro mayor ----------------------------------------------------------
    // Sin cambios en la Fase 0: estos flujos se mueven a Cloud Functions en la Fase 1
    // y las reglas se cierran en la Fase 2 (H-05, H-06).

    match /transacciones/{txId} {
      allow read: if isAuth() && (
        isSuperAdmin() ||
        resource == null ||
        (isCliente() && resource.data.clienteId == request.auth.uid) ||
        (isInfluencer() && (resource.data.clienteId == request.auth.uid || resource.data.influencerId == request.auth.uid)) ||
        ((isAdminComercio() || isVendedor()) && miComercio() == resource.data.comercioId)
      );
      allow create: if isAuth() && (
        isSuperAdmin() ||
        isVendedor() ||
        isAdminComercio() ||
        ((isCliente() || isInfluencer()) && request.resource.data.clienteId == request.auth.uid)
      );
      allow update, delete: if isAuth() && (isSuperAdmin() || isVendedor() || isAdminComercio());
    }

    match /puntos_saldos/{saldoId} {
      allow read: if isAuth() && (
        isSuperAdmin() ||
        resource == null ||
        ((isCliente() || isInfluencer()) && resource.data.clienteId == request.auth.uid) ||
        ((isAdminComercio() || isVendedor()) && miComercio() == resource.data.comercioId)
      );
      allow create: if isAuth() && (
        isSuperAdmin() ||
        isVendedor() ||
        isAdminComercio() ||
        ((isCliente() || isInfluencer()) && request.resource.data.clienteId == request.auth.uid)
      );
      allow update: if isAuth() && (
        isSuperAdmin() ||
        isVendedor() ||
        isAdminComercio() ||
        ((isCliente() || isInfluencer()) && resource.data.clienteId == request.auth.uid && request.resource.data.clienteId == request.auth.uid)
      );
      allow delete: if isAuth() && (isSuperAdmin() || isVendedor() || isAdminComercio());
    }

    match /sesiones_qr/{sesionId} {
      allow read, write: if isAuth();
    }

    // --- Influencers y códigos ------------------------------------------------

    match /asignaciones_influencer/{asignacionId} {
      allow read: if isAuth();
      allow update: if isAuth() && (
        isSuperAdmin() ||
        isCliente() ||
        (isAdminComercio() && miComercio() == resource.data.comercioId) ||
        (isInfluencer() && request.auth.uid == resource.data.influencerId)
      );
      allow create: if isAuth() && (
        isSuperAdmin() ||
        (isAdminComercio() && miComercio() == request.resource.data.comercioId) ||
        (isInfluencer() && request.auth.uid == request.resource.data.influencerId)
      );
      allow delete: if isAuth() && (
        isSuperAdmin() ||
        (isAdminComercio() && miComercio() == resource.data.comercioId) ||
        (isInfluencer() && request.auth.uid == resource.data.influencerId)
      );
    }

    match /codigos_influencer/{codigoId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isSuperAdmin() || (isInfluencer() && request.auth.uid == request.resource.data.influencerId));
      allow update: if isAuth() && (isSuperAdmin() || (isInfluencer() && request.auth.uid == resource.data.influencerId));
      allow delete: if isAuth() && (isSuperAdmin() || (isInfluencer() && request.auth.uid == resource.data.influencerId));
    }

    match /canjes_codigo/{canjeId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isSuperAdmin() || (isCliente() && request.resource.data.clienteId == request.auth.uid));
      allow update, delete: if isSuperAdmin();
    }

    match /codigos_comercio/{codigoId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isSuperAdmin() || (isAdminComercio() && miComercio() == request.resource.data.comercioId));
      allow update, delete: if isAuth() && (isSuperAdmin() || (isAdminComercio() && miComercio() == resource.data.comercioId));
    }

    match /canjes_codigos/{canjeId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isSuperAdmin() || (isCliente() && request.resource.data.clienteId == request.auth.uid));
      allow update, delete: if isSuperAdmin();
    }

    // Cualquier otra colección: solo el superadministrador. Pasa a `false` en la Fase 2,
    // cuando el libro mayor se escriba únicamente desde Cloud Functions.
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
